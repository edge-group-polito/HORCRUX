# File: ext_bus.core
# Author: Luigi Giuffrida, Valeria Piscopo
# Date: 09/01/2026
# Description: corefile for crheepto external bus

name: polito:crheepto:ext_bus
description: crheepto external bus

filesets:
  rtl:
    depend:
    - openhwgroup.org:systems:core-v-mini-mcu
    - x-heep::packages
    - polito:crheepto:packages
    files:
    - external-bus/ext_xbar.sv
    - external-bus/ext_bus.sv
    file_type: systemVerilogSource
  
  rtl-format:
    files:
    - external-bus/ext_bus.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - "!target_format ? (!target_lint ? (rtl))"
      - target_format ? (rtl-format)
      - target_lint ? (rtl-format)


