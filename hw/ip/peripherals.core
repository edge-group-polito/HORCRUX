# File: peripherals.core
# Author: Luigi Giuffrida, Valeria Piscopo
# Date: 09/01/2026
# Description: corefile for crheepto peripherals


name: polito:crheepto:peripherals
description: crheepto peripherals

filesets:
  rtl:
    depend:
    - openhwgroup.org:systems:core-v-mini-mcu
    - x-heep::packages
    - polito:crheepto:packages
    files:
    - peripherals/crheepto_peripherals.sv
    file_type: systemVerilogSource
  
  rtl-format:
    files:
    - peripherals/crheepto_peripherals.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - "!target_format ? (!target_lint ? (rtl))"
      - target_format ? (rtl-format)
      - target_lint ? (rtl-format)
