// Description: Configuration file for crheepto

{
    // CORE-V-MINI-MCU features
    cpu_features: {
        corev_pulp: true,
        corev_xif: true,
        fpu: true,
        riscv_zfinx: false,
    },

    // Slaves memory map
    ext_xbar_masters: {},
    ext_xbar_slaves: {},

    // External peripherals
    ext_periph: {},

    // ao_spc_num: 1,

    external_interrupts: 0,

}
